OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Optional: VoiceStudio at a non-default address ---
VOICESTUDIO_URL=http://localhost:3900

# --- Optional: paid social research API (skills/reference-research) ---
SCRAPECREATORS_API_KEY=
